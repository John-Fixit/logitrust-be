PORT=8002
# Used as Swagger "Try it out" server URL (optional)
API_PUBLIC_URL=http://127.0.0.1:8002
NODE_ENV=development

# In non-production, tables sync from models unless you set SYNC_DB=false
# SYNC_DB=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DIALECT=mysql

# Comma-separated origins in production, or * for development
CORS_ORIGIN=*

# Auth
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d
FRONTEND_BASE_URL=http://localhost:5173
CLERK_SECRET_KEY=

# Email verification (optional for local dev; if omitted, email preview logs to console)
MAIL_FROM=noreply@logicrow.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false